# GhostVibe Backend Environment Settings

# PostgreSQL Database Credentials
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ghostvibe

# Cache configuration (Redis)
